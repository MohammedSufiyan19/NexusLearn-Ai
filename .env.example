# ── LLM Providers ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here          # optional
TAVILY_API_KEY=your_tavily_api_key_here          # optional

# ── Database ───────────────────────────────────────
# Default is empty for local SQLite dev (nexuslearn_dev.db)
# Or set for PostgreSQL + pgvector:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexuslearn

# ── Redis ──────────────────────────────────────────
# Default is empty for graceful degradation (cache disabled)
# Or set for Redis cache & rate limiting:
REDIS_URL=redis://localhost:6379

# ── Auth & Security ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Observability (Optional) ───────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=nexuslearn-dev

# ── App Quotas & Settings ──────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_USER=20
MAX_REQUESTS_PER_DAY=100
